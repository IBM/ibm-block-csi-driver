# Description:
#    This Dockerfile.test is for running the csi controller local tests inside a container.
#    Its similar to the Dockerfile, but with additional requirements-tests.txt and ENTRYPOINT to run the local tests.

FROM registry.access.redhat.com/ubi9/python-39:1-1775726797 AS builder
USER root
# Install build dependencies for s390x and other non-x86 architectures
# gcc and python3-devel are needed for building C extensions like coverage
RUN if [[ "$(uname -m)" != "x86"* ]]; then \
    yum install -y rust-toolset gcc python3-devel && \
    yum clean all; \
    fi
USER default
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /tmp
COPY controllers/servers/csi/requirements.txt ./csi_requirements.txt
COPY controllers/servers/host_definer/requirements.txt ./host_definer_requirements.txt
# avoid default- boringssl lib, since it does not support z systems
ENV GRPC_PYTHON_BUILD_SYSTEM_OPENSSL=True
# Force pure Python implementation of protobuf on s390x to avoid segfaults
# The C++ implementation has known issues on zLinux architecture
ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
# Use pre-built wheels when available to speed up build on non-x86 platforms
ENV PIP_PREFER_BINARY=1
RUN pip3 install --timeout=300 --retries=5 grpcio==1.74.0 grpcio-tools==1.74.0
RUN pip3 install -r ./csi_requirements.txt -r ./host_definer_requirements.txt

USER root
COPY controllers/scripts/csi_general .
RUN chmod +x csi_pb2.sh
RUN ./csi_pb2.sh
RUN pip3 install .

# Requires to run local testing
COPY controllers/tests/requirements.txt ./requirements-tests.txt
# Install test requirements with timeout optimization
# Force rebuild of coverage with C extensions for s390x architecture
RUN pip3 install --timeout=300 --no-binary coverage -r ./requirements-tests.txt

FROM registry.access.redhat.com/ubi9/python-39:1-1775726797

COPY --from=builder /opt/app-root /opt/app-root
COPY ./common /driver/common
COPY ./controllers/ /driver/controllers/
USER root
RUN groupadd -g 9999 appuser && \
    useradd -u 9999 -g appuser appuser
RUN chown -R appuser:appuser /driver /opt/app-root
USER appuser
WORKDIR /driver
ENV PYTHONPATH=/driver
# Force pure Python implementation of protobuf to avoid segfaults on s390x
ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

ENTRYPOINT ["/driver/controllers/scripts/entrypoint-test.sh"]
